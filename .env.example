# Copy to .env. Defaults work for local development with `docker compose up -d db`.
DB_PORT=5433
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Each worktree points this at its own database (…/app_test_<role>); test setup creates it.
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test
PORT=3000
# Optional: the origin phones should open, e.g. http://192.168.1.5:8080. Empty = request origin.
PUBLIC_WEB_URL=
